{
  "extraKnownMarketplaces": {
    "jev-skill": {
      "source": {
        "source": "github",
        "repo": "heyman333/jev-skill"
      }
    }
  },
  "enabledPlugins": {
    "jev@jev-skill": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/session-status.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/jev-command-gate.mjs\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
