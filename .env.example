# Optional live integrations; unit tests do not need credentials.
# Copy to .env locally. Never commit filled values.
# recruiting_archive accepts env_files in its local config; invoice tools read
# process environment. This file is not automatically loaded by every command.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional invoice browser executable override (absolute path on this machine).
INVOICE_CHROME_BIN=
