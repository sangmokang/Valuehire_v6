{
  "version": "admin-weekly-dashboard-metrics/v1",
  "external_effects": {
    "clickup": "DISABLED",
    "gmail": "DISABLED",
    "jobkorea": "DISABLED",
    "linkedin": "DISABLED",
    "saramin": "DISABLED"
  },
  "groups": [
    {
      "id": "sourcing",
      "display_label": "AI Search 실행",
      "description": "Gmail에서 실제로 확인한 검색 실행과 후보만 집계합니다.",
      "order": 1
    },
    {
      "id": "mail",
      "display_label": "추가 메일 지표",
      "description": "AI Search 결과 외의 추천·포지션 메일은 아직 연결하지 않았습니다.",
      "order": 2
    },
    {
      "id": "identity",
      "display_label": "전체 후보 중복 확인",
      "description": "서로 다른 채널과 검색에 나온 같은 사람을 하나로 합치는 작업은 아직 하지 않았습니다.",
      "order": 3
    }
  ],
  "metrics": [
    {
      "id": "recommendation_mail_events",
      "display_label": "추천 메일 (연결 전)",
      "description": "추천 메일 데이터 연결 후 표시합니다.",
      "group": "mail",
      "unit": "건",
      "source_collection": "mail_events",
      "event_type": "recommendation_mail",
      "aggregation": "count"
    },
    {
      "id": "position_mail_events",
      "display_label": "포지션 메일 (연결 전)",
      "description": "포지션 메일 데이터 연결 후 표시합니다.",
      "group": "mail",
      "unit": "건",
      "source_collection": "mail_events",
      "event_type": "position_mail",
      "aggregation": "count"
    },
    {
      "id": "sourcing_runs",
      "display_label": "검색 실행",
      "description": "같은 실행으로 묶인 AI Search 결과 수",
      "group": "sourcing",
      "unit": "회",
      "source_collection": "sourcing_runs",
      "event_type": "sourcing_run",
      "aggregation": "distinct",
      "distinct_fields": ["source_system", "source_primary_key"]
    },
    {
      "id": "sourcing_positions",
      "display_label": "후보가 확인된 검색 대상",
      "description": "후보 프로필을 확인한 고객사·포지션·채널 묶음 수",
      "group": "sourcing",
      "unit": "개",
      "source_collection": "candidate_discoveries",
      "event_type": "candidate_discovery",
      "aggregation": "distinct",
      "distinct_fields": ["source_system", "position_source_id"]
    },
    {
      "id": "sourcing_raw_discoveries",
      "display_label": "확인 가능한 후보 (검색별 합계)",
      "description": "메일에서 프로필 링크를 확인한 후보 수. 다른 검색에 다시 나온 후보는 포함됩니다.",
      "group": "sourcing",
      "unit": "건",
      "source_collection": "candidate_discoveries",
      "event_type": "candidate_discovery",
      "aggregation": "count"
    },
    {
      "id": "sourcing_source_unique_candidates",
      "display_label": "중복 제거 후보 (주간·채널별)",
      "description": "같은 주와 채널 안에서 동일 프로필 링크를 한 명으로 센 수",
      "group": "sourcing",
      "unit": "명",
      "source_collection": "candidate_discoveries",
      "event_type": "candidate_discovery",
      "aggregation": "distinct",
      "distinct_fields": ["source_system", "candidate_source_key_hmac"]
    },
    {
      "id": "sourcing_global_unique_candidates",
      "display_label": "전체에서 중복 제거한 후보",
      "description": "채널과 검색을 넘나드는 동일인 확인을 마친 뒤 표시합니다.",
      "group": "identity",
      "unit": "명",
      "source_collection": "candidate_discoveries",
      "event_type": "candidate_discovery",
      "aggregation": "not_run",
      "not_run_reason": "identity_link_contract_missing"
    }
  ]
}
