#!/usr/bin/env bash
# pre-commit — 커밋 시점 로컬 강제 장치 (P4·P13·P14·P22)
#
# 계약: docs/engineering/hook-enforcement-goal-2026-08-07.md ⑩
#   출력  : exit 0 (통과) | exit 1 (차단)
#   차단 시 stderr: "BLOCKED: <사유> — <파일경로>"
#   ※ 매칭된 실제 비밀 값은 절대 출력하지 않는다 (패턴 이름과 경로만)
#   불변식: 검사를 실행하지 못하면 exit 1 (fail-closed)
#   제외  : 없음. 이 훅 자신도 검사 대상이다 (P13 ④)
#
# 이 파일에는 실패를 삼키는 구문을 쓰지 않는다 — 자기 자신이 P13 검사에 걸려야 정상이다.
set -euo pipefail

REPO=$(git rev-parse --show-toplevel)
cd "$REPO"

fail=0
block() { printf 'BLOCKED: %s\n' "$1" >&2; fail=1; }

staged=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$staged" ]; then exit 0; fi

# 스테이징된 내용에서 추가된 줄만 (grep 이 아니라 sed — 매칭 0건에도 exit 0)
added_lines() { git diff --cached -U0 -- "$1" | sed -n 's/^+//p' | sed '/^++/d'; }
# 주석·빈 줄을 뺀 패턴 목록
clean_patterns() { sed -e 's/[[:space:]]*#.*//' -e '/^[[:space:]]*$/d' "$1"; }

# ── 1) 비밀 패턴 ─────────────────────────────────────────────────────────────
SECRETS=""
if [ -f .secret-patterns ]; then SECRETS=.secret-patterns
elif [ -f .secret-patterns.default ]; then SECRETS=.secret-patterns.default
fi
if [ -z "$SECRETS" ]; then
  block "비밀 패턴 파일이 없어 스캔 불가 (fail-closed)"
else
  pf=$(mktemp); clean_patterns "$SECRETS" > "$pf"
  while IFS= read -r f; do
    if [ -s "$pf" ] && git show ":$f" | grep -qEf "$pf"; then
      block "비밀 패턴 매칭 — $f (패턴 파일: $SECRETS)"
    fi
  done <<< "$staged"
  rm -f "$pf"
fi

# ── 2) 검사기 자기 제외 (P13 ④ · §0 E1 재현 방지) ────────────────────────────
while IFS= read -r f; do
  case "$f" in
    verify.sh|scripts/*.sh|hooks/*)
      base=$(basename "$f")
      esc=$(printf '%s' "$base" | sed 's/[.[\*^$]/\\&/g')
      if git show ":$f" | grep -qE "grep -v.*${esc}"; then
        block "검사기 자기 제외 — $f 가 자기 자신을 검사 대상에서 뺀다 (P13)"
      fi
      ;;
  esac
done <<< "$staged"

# ── 3) 검사 약화 (P13 · 48143a7·129f61d 재현 방지) ────────────────────────────
WEAKEN_FILE=.check-weakening-patterns
if [ ! -f "$WEAKEN_FILE" ]; then
  block "$WEAKEN_FILE 없음 — 약화 탐지 불가 (fail-closed)"
else
  wf=$(mktemp); clean_patterns "$WEAKEN_FILE" > "$wf"
  while IFS= read -r f; do
    case "$f" in
      *.sh|*.yml|*.yaml|hooks/*)
        # 주석은 실행되지 않으므로 약화가 아니다 — 주석 부분을 떼고 검사한다.
        if [ -s "$wf" ] && added_lines "$f" | sed 's/[[:space:]]*#.*//' | grep -qEf "$wf"; then
          block "검사 약화 패턴 추가 — $f (P13). 정당하면 suppressions.yaml 에 expiry 와 함께 등록하라"
        fi
        ;;
    esac
  done <<< "$staged"
  rm -f "$wf"
fi

# ── 4) 만료일 없는 억제 (P13 ③ · 98d923f 35일 방치 재현 방지) ─────────────────
if printf '%s\n' "$staged" | grep -qx 'suppressions.yaml'; then
  sup=$(git show ":suppressions.yaml")
  n_check=$(printf '%s\n' "$sup" | awk '/^- *check:/{c++} END{print c+0}')
  n_exp=$(printf '%s\n' "$sup" | awk '/^ *expiry:/{c++} END{print c+0}')
  if [ "$n_check" -ne "$n_exp" ]; then
    block "억제 항목 ${n_check}건 중 expiry 가 ${n_exp}건뿐 — 만료일 없는 억제는 영구화된다 (P13)"
  fi
fi

# ── 5) LLM 출력 숫자를 판정 필드에 (P14 · v4 QA-094 재현 방지) ────────────────
while IFS= read -r f; do
  case "$f" in
    *.js|*.mjs|*.ts|*.tsx|*.py)
      body=$(git show ":$f")
      if printf '%s' "$body" | grep -qiE 'llm|gpt|claude|completion|chat\(' &&
         printf '%s' "$body" | grep -qiE 'score|rating|fit_|적합도' &&
         printf '%s' "$body" | grep -qE 'parseFloat|parseInt|Number\(|float\('; then
        block "LLM 출력을 판정 수치로 변환 — $f. 판정 수치는 순수 함수가 만든다 (P14)"
      fi
      ;;
  esac
done <<< "$staged"

# ── 6) 외부 효과 모듈에 네트워크 호출 0건 (P4 · §0 E5 gptreview.js 재현 방지) ──
while IFS= read -r f; do
  case "$f" in
    *login*|*portal*|*scrap*|*crawl*|*gptreview*|*fetch*|*api*)
      case "$f" in
        *.js|*.mjs|*.ts|*.tsx|*.py)
          body=$(git show ":$f")
          if ! printf '%s' "$body" | grep -qiE 'fetch\(|axios|https?\.|requests\.|urllib|playwright|puppeteer|page\.goto|XMLHttpRequest|WebSocket|subprocess|execSync'; then
            block "외부 효과를 표방하는데 네트워크 호출이 0건 — $f. 시뮬레이션 의심 (P4)"
          fi
          ;;
      esac
      ;;
  esac
done <<< "$staged"

exit "$fail"
