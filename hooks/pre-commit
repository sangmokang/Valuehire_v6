#!/usr/bin/env bash
# pre-commit — 커밋 시점 로컬 강제 장치 (P4·P13·P14·P22)
#
# 계약: docs/sot/hook-contracts.md
#   출력  : exit 0 (통과) | exit 1 (차단)
#   차단 시 stderr: "BLOCKED: <사유> — <파일경로>"
#   ※ 매칭된 실제 비밀 값은 절대 출력하지 않는다 (패턴 이름과 경로만)
#   불변식: 검사를 실행하지 못하면 exit 1 (fail-closed)
#   제외  : 없음. 이 훅 자신도 검사 대상이다 (P13 ④)
#
# fail-open 방지 규칙 (2026-08-07 실측으로 추가):
#   grep 은 매칭 없음이 exit 1, 실행 오류가 exit >=2 다. 이 둘을 구분하지 않으면
#   패턴이 깨져 검사가 돌지 않은 경우까지 "위반 없음"으로 통과한다. 실제로 발생했다.
#   따라서 모든 스캔은 scan() 을 통하며, exit >=2 는 차단으로 처리한다.
set -euo pipefail

REPO=$(git rev-parse --show-toplevel)
cd "$REPO"

fail=0
block() { printf 'BLOCKED: %s\n' "$1" >&2; fail=1; }

# 글로브나 staged diff에 기대면 두 파일을 함께 삭제한 커밋은 검사 자체를 없앤 채 통과한다.
# 현재 인덱스에 고정 필수 파일이 있는지 다른 검사보다 먼저 확인한다.
REQUIRED_PRINCIPLES_FILES="docs/sot/principles.yaml scripts/acceptance-principles-check.sh"
for required in $REQUIRED_PRINCIPLES_FILES; do
  if ! git cat-file -e ":$required" 2>/dev/null; then
    block "P1 필수 파일이 인덱스에 없다 — $required (삭제·이름 변경 금지)"
  fi
done
checker_mode=$(git ls-files -s -- scripts/acceptance-principles-check.sh | awk 'NR==1 {print $1}')
if [ "$checker_mode" != "100755" ]; then
  block "P1 검사기가 인덱스에서 실행 가능하지 않다 — scripts/acceptance-principles-check.sh (mode=${checker_mode:-missing})"
fi
if [ "$fail" -ne 0 ]; then exit 1; fi

# R(rename)을 넣지 않으면 `git mv notes.txt leak.db` 가 staged 목록에서 빠져
# 훅을 그대로 통과한다(2026-08-09 실측). 이름만 바꿔도 내용은 그대로다.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$staged" ]; then exit 0; fi

# scan <설명> <파일> <grep 인자...>
#   반환 0 = 매칭됨 / 1 = 매칭 없음 또는 실행오류(이 경우 block 이 이미 걸림)
scan() {
  local desc="$1" f="$2"; shift 2
  local rc=0
  git show ":$f" | grep -q "$@" || rc=$?
  if [ "$rc" -gt 1 ]; then
    block "검사 실행 실패 — $desc / $f (grep exit=$rc · fail-closed)"
    return 1
  fi
  return "$rc"
}

# scan_added <설명> <파일> <grep 인자...>  — 추가된 줄에서 주석을 뗀 뒤 검사
scan_added() {
  local desc="$1" f="$2"; shift 2
  local rc=0
  git diff --cached -U0 -- "$f" | sed -n 's/^+//p' | sed '/^++/d' \
    | sed 's/[[:space:]]*#.*//' | grep -q "$@" || rc=$?
  if [ "$rc" -gt 1 ]; then
    block "검사 실행 실패 — $desc / $f (grep exit=$rc · fail-closed)"
    return 1
  fi
  return "$rc"
}

clean_patterns() { sed -e 's/[[:space:]]*#.*//' -e '/^[[:space:]]*$/d' "$1"; }

# ── 1) 비밀 패턴 — verify.sh 에 위임한다 (원칙 A: 하나의 정책 = 하나의 판정 함수)
#
# 여기서 자체 스캔을 구현하면 판정기가 2벌이 되고, 실제로 갈렸다(2026-08-07 실측):
#   verify.sh          : .default + .secret-patterns 합집합 / tr -d '\r' 정규화 / grep -i
#   자체 구현(폐기)    : 둘 중 하나만 / 정규화 없음 / -i 없음  → 같은 저장소에서 다른 판정
# VERIFY_SCAN_SOURCE=index 로 부른다. 기본(worktree) 모드는 목록만 인덱스에서 읽고
# 내용은 작업트리에서 읽으므로 다음으로 우회된다(V1 2026-08-07 실측):
#   git add <비밀> → 작업트리만 깨끗하게 덮어씀 → git commit → 통과, 커밋에는 비밀이 들어감
if [ ! -f verify.sh ]; then
  block "verify.sh 없음 — 비밀 스캔 불가 (fail-closed)"
else
  # SECRET_PATTERNS_FILE 을 비워 고정한다. 상속하면 호출자가
  #   SECRET_PATTERNS_FILE=/tmp/weak.txt git commit
  # 로 "유효하지만 아무것도 안 잡는" 패턴 파일을 주입해 스캔을 무력화할 수 있다
  # (2026-08-07 실측: AKIA…·ghp_… 가 그대로 커밋됨). 빈 값이면 verify.sh 가
  # .secret-patterns.default + .secret-patterns 합집합이라는 기본 경로를 탄다.
  vrc=0
  SECRET_PATTERNS_FILE= VERIFY_SCAN_SOURCE=index bash verify.sh >/dev/null 2>&1 || vrc=$?
  if [ "$vrc" -ne 0 ]; then
    block "비밀 스캔 실패 (verify.sh --index exit=$vrc). 상세: VERIFY_SCAN_SOURCE=index bash verify.sh"
  fi
fi

# ── 2) 검사기 자기 제외 (P13 ④ · §0 E1 재현 방지) ────────────────────────────
while IFS= read -r f; do
  case "$f" in
    verify.sh|scripts/*.sh|hooks/*)
      base=$(basename "$f")
      # ERE 메타문자 이스케이프. ']' 는 문자 클래스 맨 앞에 와야 한다.
      esc=$(printf '%s' "$base" | sed 's/[].[*^$+?(){}|\\]/\\&/g')
      if scan "자기제외" "$f" -E "grep -v[^|]*${esc}"; then
        block "검사기 자기 제외 — $f 가 자기 자신을 검사 대상에서 뺀다 (P13)"
      fi
      ;;
  esac
done <<< "$staged"

# ── 3) 검사 약화 (P13 · 48143a7·129f61d 재현 방지) ────────────────────────────
WEAKEN_FILE=.check-weakening-patterns
if [ ! -f "$WEAKEN_FILE" ]; then
  block "$WEAKEN_FILE 없음 — 약화 탐지 불가 (fail-closed)"
else
  wf=$(mktemp); clean_patterns "$WEAKEN_FILE" > "$wf"
  if [ ! -s "$wf" ]; then
    block "$WEAKEN_FILE 에 유효 패턴이 0개 (fail-closed)"
  else
    while IFS= read -r f; do
      case "$f" in
        *.sh|*.yml|*.yaml|hooks/*)
          if scan_added "검사약화" "$f" -Ef "$wf"; then
            block "검사 약화 패턴 추가 — $f (P13). 정당하면 suppressions.yaml 에 expiry 와 함께 등록하라"
          fi
          ;;
      esac
    done <<< "$staged"
  fi
  rm -f "$wf"
fi

# ── 4) 만료일 없는 억제 (P13 ③ · 98d923f 35일 방치 재현 방지) ─────────────────
if printf '%s\n' "$staged" | grep -qx 'suppressions.yaml'; then
  sup=$(git show ":suppressions.yaml")
  n_check=$(printf '%s\n' "$sup" | awk '/^- *check:/{c++} END{print c+0}')
  n_exp=$(printf '%s\n' "$sup" | awk '/^ *expiry:/{c++} END{print c+0}')
  if [ "$n_check" -ne "$n_exp" ]; then
    block "억제 항목 ${n_check}건 중 expiry 가 ${n_exp}건뿐 — 만료일 없는 억제는 영구화된다 (P13)"
  fi
  # 개수만 맞추면 expiry: 1999-01-01 도 통과한다. 날짜 자체를 본다.
  # 값 정제를 하지 않는다 — gsub 로 숫자만 남기면 'never' 가 빈 문자열이 되어
  # 형식 검사를 빠져나간다. 원문 그대로 받아 YYYY-MM-DD 인지 먼저 확인한다.
  # (빈 값 / '99-01-01' / 'never' / '9999-99-99' 가 전부 통과하던 것을 막는다)
  today=$(date +%Y-%m-%d)
  while IFS= read -r e; do
    if ! printf '%s' "$e" | grep -qE '^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'; then
      block "expiry 형식이 YYYY-MM-DD 가 아니다: '${e}' — 만료를 판정할 수 없는 억제는 무기한 억제다 (P13)"
    elif [ "$e" \< "$today" ]; then
      block "만료된 억제가 남아 있다 (expiry: $e < 오늘 $today) — 유예는 기한이 지나면 해제되어야 한다 (P13)"
    fi
  done <<< "$(printf '%s\n' "$sup" | awk '/^ *expiry:/{sub(/^ *expiry: */,""); gsub(/["\x27]/,""); print}')"
fi

# ── 5) LLM 출력 숫자를 판정 필드에 (P14 · v4 QA-094 재현 방지) ────────────────
while IFS= read -r f; do
  case "$f" in
    *.js|*.mjs|*.ts|*.tsx|*.py)
      if scan "LLM판정-소스" "$f" -iE 'llm|gpt|claude|completion|chat\(' &&
         scan "LLM판정-필드" "$f" -iE 'score|rating|fit_|적합도' &&
         scan "LLM판정-변환" "$f" -E 'parseFloat|parseInt|Number\(|float\('; then
        block "LLM 출력을 판정 수치로 변환 — $f. 판정 수치는 순수 함수가 만든다 (P14)"
      fi
      ;;
  esac
done <<< "$staged"

# ── 6) 외부 효과 모듈에 네트워크 호출 0건 (P4 · §0 E5 gptreview.js 재현 방지) ──
NET='fetch\(|axios|https?\.|requests\.|urllib|playwright|puppeteer|page\.goto|XMLHttpRequest|WebSocket|subprocess|execSync'
while IFS= read -r f; do
  case "$f" in
    *login*|*portal*|*scrap*|*crawl*|*gptreview*|*fetch*|*api*)
      case "$f" in
        *.js|*.mjs|*.ts|*.tsx|*.py)
          if ! scan "외부효과-네트워크" "$f" -iE "$NET"; then
            block "외부 효과를 표방하는데 네트워크 호출이 0건 — $f. 시뮬레이션 의심 (P4)"
          fi
          ;;
      esac
      ;;
  esac
done <<< "$staged"

# ── 7) 대용량 파일 · 산출물 경로 (P21 · AC-A4) ────────────────────────────────
#
# 왜: v6 는 후보자 개인정보(이름·학력·경력·프로필URL)를 로컬 SQLite 와 artifacts/ 에
# 쌓는다. 구현 계획 §8 은 그 보호를 "gitignore + 1MB 차단"에 기대는데, 2026-08-08
# 실측에서 **둘 다 존재하지 않았다**. gitignore 만으로는 부족하다 — `git add -f` 가
# 무시 규칙을 건너뛰므로, 경로 차단을 훅에도 둔다(차단 지점 2곳).
#
# 크기는 작업트리가 아니라 **인덱스 blob** 에서 잰다. 작업트리를 재면
# `git add <큰 파일>` 후 작업트리만 작은 내용으로 덮어써서 우회할 수 있다
# (§1 비밀 스캔이 VERIFY_SCAN_SOURCE=index 를 쓰는 것과 같은 이유).
#
# 경로 패턴은 **하위 디렉터리까지** 덮는다. 최상위만 보면 src/artifacts/nav.png 로 뚫린다
# (2026-08-09 보안 재검증 실측). gitignore 는 원래 모든 깊이를 덮으므로, 훅만 좁았던 것이다.
# 확장자도 사이드카를 포함한다 — SQLite WAL(.db-wal / .sqlite3-wal)은 아직 본체에 반영되지
# 않은 행 전체를 담고, .jsonl/.ndjson/.parquet 은 후보자 덤프의 실제 형식이다.
# 의도적으로 뺀 것: *.sql(마이그레이션이 정상 산출물) · *.csv(소형 픽스처와 구분 불가).
# 그 둘은 크기 검사와 비밀/PII 내용 검사에 맡긴다 — 여기서 막으면 정상 작업이 멈춘다.
MAX_BYTES=1048576
while IFS= read -r f; do
  if [ -z "$f" ]; then continue; fi
  # 확장자 비교는 대소문자를 무시한다. dump.DB 가 그냥 통과했다(2026-08-09 실측).
  lf=$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')
  case "$lf" in
    artifacts/*|*/artifacts/*|data/*|*/data/*|private-reviews/*|*/private-reviews/*|\
    *.db|*.db-*|*.sqlite|*.sqlite-*|*.sqlite3|*.sqlite3-*|*.jsonl|*.ndjson|*.parquet)
      block "산출물·데이터 경로는 커밋하지 않는다 — $f (P21 · 후보자 PII)"
      continue
      ;;
  esac
  sz=$(git cat-file -s ":$f" 2>&1) || sz=""
  case "$sz" in
    ''|*[!0-9]*)
      block "스테이지된 blob 크기를 읽지 못했다 — $f (fail-closed)"
      ;;
    *)
      if [ "$sz" -gt "$MAX_BYTES" ]; then
        block "1MB 초과 파일 — $f (${sz} 바이트, P21). 데이터는 git 밖에 둔다"
      fi
      ;;
  esac
done <<< "$staged"

exit "$fail"
