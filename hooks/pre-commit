#!/usr/bin/env bash
# pre-commit — 커밋 시점 로컬 강제 장치 (P4·P13·P14·P22)
#
# 계약: docs/sot/hook-contracts.md
#   출력  : exit 0 (통과) | exit 1 (차단)
#   차단 시 stderr: "BLOCKED: <사유> — <파일경로>"
#   ※ 매칭된 실제 비밀 값은 절대 출력하지 않는다 (패턴 이름과 경로만)
#   불변식: 검사를 실행하지 못하면 exit 1 (fail-closed)
#   제외  : 없음. 이 훅 자신도 검사 대상이다 (P13 ④)
#
# fail-open 방지 규칙 (2026-08-07 실측으로 추가):
#   grep 은 매칭 없음이 exit 1, 실행 오류가 exit >=2 다. 이 둘을 구분하지 않으면
#   패턴이 깨져 검사가 돌지 않은 경우까지 "위반 없음"으로 통과한다. 실제로 발생했다.
#   따라서 모든 스캔은 scan() 을 통하며, exit >=2 는 차단으로 처리한다.
set -euo pipefail

REPO=$(git rev-parse --show-toplevel)
cd "$REPO"

fail=0
# 차단은 둘로 나뉜다. 섞으면 "검사를 못 돌렸다"가 "검사가 위반을 찾았다"로 계수되고,
# 검사기·고정물·임시 디렉터리가 망가진 상태가 방어 성공으로 장부에 남는다(P13 counter-AC).
#   block()            — 판정: 검사가 돌았고 위반을 찾았다
#   block_unrunnable() — 실행 불가: 검사를 돌리지 못했다. 막기는 하되(fail-closed) 판정은 아니다
#
# 분류는 **로그 본문이 아니라 별도 채널**로도 내보낸다. 훅은 하위 검사기의 출력을 그대로
# 보여 주는데(사유가 그 안에 있으므로), 그 출력도 `BLOCKED:` 로 시작한다. 그래서 로그
# 줄머리만 보면 **검사기가 쓴 글자**를 훅의 분류로 착각한다 — 검사기 본문은 공격자가
# 고를 수 있으므로, 판정자가 피고의 진술서를 증거로 쓰는 구조가 된다
# (2026-09-11 V2 적대검증 결함 2: 검사기가 죽기 직전에 BLOCKED: 한 줄만 찍게 하면
#  실행 불가로만 막힌 공격이 "판정으로 막혔다"로 집계됐다).
# 채널은 .git 아래 파일이다. 커밋 내용이 아니므로 이번 커밋으로는 위조할 수 없고,
# 훅이 **모든 검사가 끝난 뒤** 마지막에 덮어쓰므로 검사기가 미리 써 두어도 지워진다.
n_verdict=0
n_unrunnable=0
block() { printf 'BLOCKED: %s\n' "$1" >&2; fail=1; n_verdict=$((n_verdict + 1)); }
block_unrunnable() { printf 'BLOCKED(실행불가): %s\n' "$1" >&2; fail=1; n_unrunnable=$((n_unrunnable + 1)); }

HOOK_SUMMARY="$(git rev-parse --git-dir)/p13-last-block-summary"
write_summary() {
  printf 'verdict=%d unrunnable=%d\n' "$n_verdict" "$n_unrunnable" > "$HOOK_SUMMARY" 2>/dev/null
}
# 먼저 0/0 으로 초기화한다. 안 그러면 조기 종료 경로에서 **지난 커밋의 기록**이 남아
# 이번 커밋의 분류로 읽힌다.
write_summary

# R(rename)을 넣지 않으면 `git mv notes.txt leak.db` 가 staged 목록에서 빠져
# 훅을 그대로 통과한다(2026-08-09 실측). 이름만 바꿔도 내용은 그대로다.
staged=$(git diff --cached --name-only --diff-filter=ACMR)
# 조기 종료는 ACMR 이 아니라 **전체** 스테이징으로 판단한다. ACMR 로 판단하면
# 삭제만 하는 커밋(git rm)에서 목록이 비어 훅 전체가 exit 0 으로 건너뛰어진다 —
# 비밀 스캔·자기제외·약화 탐지·억제 만료까지 전부 우회됐다(2026-09-09 실측:
# `git rm .github/workflows/verify.yml` 단독 커밋이 아무 검사도 거치지 않고 통과).
# 아래 검사들은 파일 **내용**을 읽으므로 계속 ACMR 목록을 쓴다. 삭제된 파일은 읽을
# 내용이 없고, 삭제로 인한 약화는 3-b 가 diff 로 따로 본다.
staged_any=$(git diff --cached --name-only)
if [ -z "$staged_any" ]; then write_summary; exit 0; fi

# scan <설명> <파일> <grep 인자...>
#   반환 0 = 매칭됨 / 1 = 매칭 없음 또는 실행오류(이 경우 block 이 이미 걸림)
scan() {
  local desc="$1" f="$2"; shift 2
  local rc=0
  git show ":$f" | grep -q "$@" || rc=$?
  if [ "$rc" -gt 1 ]; then
    block_unrunnable "검사 실행 실패 — $desc / $f (grep exit=$rc · fail-closed)"
    return 1
  fi
  return "$rc"
}

# scan_added <설명> <파일> <grep 인자...>  — 추가된 줄에서 주석을 뗀 뒤 검사
scan_added() {
  local desc="$1" f="$2"; shift 2
  local rc=0
  git diff --cached -U0 -- "$f" | sed -n 's/^+//p' | sed '/^++/d' \
    | sed 's/[[:space:]]*#.*//' | grep -q "$@" || rc=$?
  if [ "$rc" -gt 1 ]; then
    block_unrunnable "검사 실행 실패 — $desc / $f (grep exit=$rc · fail-closed)"
    return 1
  fi
  return "$rc"
}

clean_patterns() { sed -e 's/[[:space:]]*#.*//' -e '/^[[:space:]]*$/d' "$1"; }

# ── 1) 비밀 패턴 — verify.sh 에 위임한다 (원칙 A: 하나의 정책 = 하나의 판정 함수)
#
# 여기서 자체 스캔을 구현하면 판정기가 2벌이 되고, 실제로 갈렸다(2026-08-07 실측):
#   verify.sh          : .default + .secret-patterns 합집합 / tr -d '\r' 정규화 / grep -i
#   자체 구현(폐기)    : 둘 중 하나만 / 정규화 없음 / -i 없음  → 같은 저장소에서 다른 판정
# VERIFY_SCAN_SOURCE=index 로 부른다. 기본(worktree) 모드는 목록만 인덱스에서 읽고
# 내용은 작업트리에서 읽으므로 다음으로 우회된다(V1 2026-08-07 실측):
#   git add <비밀> → 작업트리만 깨끗하게 덮어씀 → git commit → 통과, 커밋에는 비밀이 들어감
if [ ! -f verify.sh ]; then
  block_unrunnable "verify.sh 없음 — 비밀 스캔 불가 (fail-closed)"
else
  # SECRET_PATTERNS_FILE 을 비워 고정한다. 상속하면 호출자가
  #   SECRET_PATTERNS_FILE=/tmp/weak.txt git commit
  # 로 "유효하지만 아무것도 안 잡는" 패턴 파일을 주입해 스캔을 무력화할 수 있다
  # (2026-08-07 실측: AKIA…·ghp_… 가 그대로 커밋됨). 빈 값이면 verify.sh 가
  # .secret-patterns.default + .secret-patterns 합집합이라는 기본 경로를 탄다.
  vrc=0
  SECRET_PATTERNS_FILE= VERIFY_SCAN_SOURCE=index bash verify.sh >/dev/null 2>&1 || vrc=$?
  if [ "$vrc" -ne 0 ]; then
    if [ "$vrc" -ge 2 ]; then
      block_unrunnable "비밀 스캔 실패 (verify.sh --index exit=$vrc). 상세: VERIFY_SCAN_SOURCE=index bash verify.sh"
    else
      block "비밀 스캔 실패 (verify.sh --index exit=$vrc). 상세: VERIFY_SCAN_SOURCE=index bash verify.sh"
    fi
  fi
fi

# ── 2) 검사기 자기 제외 (P13 ④ · §0 E1 재현 방지) ────────────────────────────
while IFS= read -r f; do
  case "$f" in
    verify.sh|scripts/*.sh|hooks/*)
      base=$(basename "$f")
      # ERE 메타문자 이스케이프. ']' 는 문자 클래스 맨 앞에 와야 한다.
      esc=$(printf '%s' "$base" | sed 's/[].[*^$+?(){}|\\]/\\&/g')
      if scan "자기제외" "$f" -E "grep -v[^|]*${esc}"; then
        block "검사기 자기 제외 — $f 가 자기 자신을 검사 대상에서 뺀다 (P13)"
      fi
      ;;
  esac
done <<< "$staged"

# ── 3) 검사 약화 (P13 · 48143a7·129f61d 재현 방지) ────────────────────────────
WEAKEN_FILE=.check-weakening-patterns
if [ ! -f "$WEAKEN_FILE" ]; then
  block_unrunnable "$WEAKEN_FILE 없음 — 약화 탐지 불가 (fail-closed)"
else
  wf=$(mktemp); clean_patterns "$WEAKEN_FILE" > "$wf"
  if [ ! -s "$wf" ]; then
    block_unrunnable "$WEAKEN_FILE 에 유효 패턴이 0개 (fail-closed)"
  else
    while IFS= read -r f; do
      case "$f" in
        # .secret-patterns.default 를 뺀 채로는 검사기를 한 줄도 안 고치고
        # **검사 기준**만 손대는 경로가 열려 있었다 (2026-09-03 실측: 이 저장소의
        # 비밀 정책 전체가 그 파일 한 장에 있다). 규칙을 정하는 파일이 규칙 약화
        # 감시 밖에 있으면 감시의 의미가 없다. 시연: scripts/acceptance-0-7.sh 7번.
        #
        # .check-weakening-patterns 는 일부러 넣지 않는다 — 그 파일 자체가 약화
        # 리터럴 목록이라 새 약화 패턴을 추가하는 정당한 작업이 자기 매칭으로
        # 영구 차단된다(넣었다가 되돌린 이유를 남긴다).
        *.sh|*.yml|*.yaml|hooks/*|.secret-patterns.default)
          if scan_added "검사약화" "$f" -Ef "$wf"; then
            block "검사 약화 패턴 추가 — $f (P13). 정당하면 suppressions.yaml 에 expiry 와 함께 등록하라"
          fi
          ;;
      esac
    done <<< "$staged"
  fi
  rm -f "$wf"
fi

# ── 3-b) 검사 실행 줄 삭제 (P13 · 억제 p13-deletion-blindspot 해제) ───────────
# 위 3) 은 scan_added 라서 **추가된 줄**만 본다. 검사 줄을 지우는 약화는 원리적으로
# 보이지 않았다. 범위를 .github/workflows/* 로 한정하면 오탐이 거의 없다는 데 V1 과
# 합의했고, 그 범위부터 도입한다. 판정은 별도 검사기에 위임한다 — 훅 안에 규칙을
# 인라인하면 그 규칙을 격리 사본으로 공격하는 인수 검사를 쓸 수 없다.
DEL_CHECKER=scripts/verify/check-workflow-deletion.sh
if [ ! -x "$DEL_CHECKER" ]; then
  block_unrunnable "$DEL_CHECKER 없음 또는 실행 권한 없음 — 삭제 약화 탐지 불가 (fail-closed)"
else
  dout=$(mktemp) || block_unrunnable "임시 파일 생성 실패 — 삭제 약화 판정 근거를 모을 수 없다 (fail-closed)"
  if [ -n "${dout:-}" ] && [ -f "$dout" ]; then
    drc=0
    bash "$DEL_CHECKER" >"$dout" 2>&1 || drc=$?
    if [ "$drc" -ne 0 ]; then
      # 검사기 출력을 그대로 보인다. 사유(경로·스크립트)는 그 안에 있다.
      cat "$dout" >&2
      if [ "$drc" -ge 2 ]; then
        block_unrunnable "검사 실행 줄 삭제 (check-workflow-deletion exit=$drc)"
      else
        block "검사 실행 줄 삭제 (check-workflow-deletion exit=$drc)"
      fi
    fi
    rm -f "$dout"
  fi
fi

# ── 3-c) 비밀 탐지력 축소 (P13 · 2026-09-10 Codex 적대검증 반례) ──────────────
# 위 3) 은 추가된 줄을 일반 약화 리터럴 목록과 대조한다. 비밀 규칙 파일에는 그 방식이
# 원리적으로 통하지 않는다 — 규칙 **삭제**는 추가된 줄이 없어 입력에 들어오지도 않고,
# 수량 하한을 {16} → {99} 로 올리는 **수정**은 어떤 약화 리터럴과도 일치하지 않는다.
# 실측: AKIA 규칙을 지운 커밋이 통과했고 **바로 다음 커밋에서 실제 AWS 키가 통과했다**.
# 그래서 문법이 아니라 **무엇을 잡는가**로 판정한다 — 기준(HEAD) 패턴과 커밋될 패턴으로
# 카나리를 각각 돌려 검출 집합을 비교한다.
DETECT_REG_CHECKER=scripts/verify/check-secret-detection-regression.sh
# 트리거는 규칙 파일**과 카나리 고정물** 둘 다다. 규칙 파일만 보면 카나리를 줄여
# 감시를 무장해제하는 경로가 열린다 — 그 다음 커밋부터는 축소가 자유롭다(2026-09-11 실측).
if printf '%s\n' "$staged_any" | grep -qE '^(\.secret-patterns\.default|scripts/verify/fixtures/secret-canaries/)'; then
  if [ ! -x "$DETECT_REG_CHECKER" ]; then
    block_unrunnable "$DETECT_REG_CHECKER 없음 또는 실행 권한 없음 — 탐지력 축소 판정 불가 (fail-closed)"
  else
    sout=$(mktemp) || block_unrunnable "임시 파일 생성 실패 — 탐지력 판정 근거를 모을 수 없다 (fail-closed)"
    if [ -n "${sout:-}" ] && [ -f "$sout" ]; then
      src=0
      bash "$DETECT_REG_CHECKER" >"$sout" 2>&1 || src=$?
      if [ "$src" -ne 0 ]; then
        cat "$sout" >&2
        if [ "$src" -ge 2 ]; then
          block_unrunnable "비밀 탐지력 축소 (check-secret-detection-regression exit=$src)"
        else
          block "비밀 탐지력 축소 (check-secret-detection-regression exit=$src)"
        fi
      fi
      rm -f "$sout"
    fi
  fi
fi

# ── 3-d) 비밀 규칙 카나리 커버리지 (P13 · 2026-09-11 Codex 적대검증 C2) ──────
# 위 3-c 는 "기준에서 잡히던 값이 계속 잡히는가"만 본다. 그래서 **어떤 카나리도 대표하지
# 않는 규칙**은 통째로 사라져도 검출 집합이 안 변해 조용히 통과한다. 실측: 규칙 25개 중
# 카나리에 연결된 것은 4개뿐이었고, 나머지 21개는 지워도 3-c 가 초록이었다.
# manifest(capability → 카나리 → 규칙 id)를 정본으로 두고, 적힌 대로 실제 잡히는지
# 실행으로 확인한다 — 서류만 맞추면 통과하는 검사는 검사가 아니다.
COVER_CHECKER=scripts/verify/check-secret-canary-coverage.sh
if printf '%s\n' "$staged_any" | grep -qE '^(\.secret-patterns\.default|scripts/verify/fixtures/secret-canaries/)'; then
  if [ ! -x "$COVER_CHECKER" ]; then
    block_unrunnable "$COVER_CHECKER 없음 또는 실행 권한 없음 — 커버리지 판정 불가 (fail-closed)"
  else
    cout=$(mktemp) || block_unrunnable "임시 파일 생성 실패 — 커버리지 판정 근거를 모을 수 없다 (fail-closed)"
    if [ -n "${cout:-}" ] && [ -f "$cout" ]; then
      crc=0
      bash "$COVER_CHECKER" >"$cout" 2>&1 || crc=$?
      if [ "$crc" -ne 0 ]; then
        cat "$cout" >&2
        if [ "$crc" -ge 2 ]; then
          block_unrunnable "비밀 규칙 카나리 커버리지 (check-secret-canary-coverage exit=$crc)"
        else
          block "비밀 규칙 카나리 커버리지 (check-secret-canary-coverage exit=$crc)"
        fi
      fi
      rm -f "$cout"
    fi
  fi
fi

# ── 4) 만료일 없는 억제 (P13 ③ · 98d923f 35일 방치 재현 방지) ─────────────────
if printf '%s\n' "$staged" | grep -qx 'suppressions.yaml'; then
  sup=$(git show ":suppressions.yaml")
  n_check=$(printf '%s\n' "$sup" | awk '/^- *check:/{c++} END{print c+0}')
  n_exp=$(printf '%s\n' "$sup" | awk '/^ *expiry:/{c++} END{print c+0}')
  if [ "$n_check" -ne "$n_exp" ]; then
    block "억제 항목 ${n_check}건 중 expiry 가 ${n_exp}건뿐 — 만료일 없는 억제는 영구화된다 (P13)"
  fi
  # owner 와 reason 도 필수다 (2026-09-10 Codex 적대검증 반영). expiry 만 요구하면
  # "누가 승인했고 왜 유예하는가"가 비어 있는 항목이 통과한다. 특히 `retire:<경로>` 승인은
  # 검사를 영구히 없애는 결정이라, 책임자와 근거가 없으면 그냥 조용한 삭제와 같아진다.
  count_sup_field() { printf '%s\n' "$sup" | awk -v f="$1" '$0 ~ "^ *" f ":" {c++} END{print c+0}'; }
  n_own=$(count_sup_field owner)
  n_rsn=$(count_sup_field reason)
  if [ "$n_check" -ne "$n_own" ]; then
    block "억제 항목 ${n_check}건 중 owner 가 ${n_own}건뿐 — 책임자 없는 유예는 승인이 아니다 (P13)"
  fi
  if [ "$n_check" -ne "$n_rsn" ]; then
    block "억제 항목 ${n_check}건 중 reason 이 ${n_rsn}건뿐 — 근거 없는 유예는 재검토할 수 없다 (P13)"
  fi
  # 개수만 맞추면 `owner:` 빈 값도 통과한다. 값이 실제로 있는지 본다.
  #
  # 셈을 awk 안에서 끝낸다. 값 목록을 `$(...)` 로 받아 한 줄씩 읽으면 **마지막 항목의
  # 빈 값이 통째로 사라진다** — 명령 치환이 끝의 빈 줄을 잘라내기 때문이다.
  # 2026-09-11 변조 실측 M11: 파일 끝에 `owner:` 를 비운 채 추가한 억제가 통과했다.
  # 중간에 있으면 잡히고 끝에 있으면 통과하는, 위치에 따라 갈리는 검사였다.
  n_blank_owner=$(printf '%s\n' "$sup" | awk '
    /^ *owner:/ { v = $0; sub(/^ *owner: */, "", v); gsub(/[[:space:]"\x27]/, "", v); if (v == "") c++ }
    END { print c+0 }')
  if [ "$n_blank_owner" -gt 0 ]; then
    block "owner 값이 빈 억제가 ${n_blank_owner}건 — 책임자 없는 유예는 승인이 아니다 (P13)"
  fi
  # 개수만 맞추면 expiry: 1999-01-01 도 통과한다. 날짜 자체를 본다.
  # 값 정제를 하지 않는다 — gsub 로 숫자만 남기면 'never' 가 빈 문자열이 되어
  # 형식 검사를 빠져나간다. 원문 그대로 받아 YYYY-MM-DD 인지 먼저 확인한다.
  # (빈 값 / '99-01-01' / 'never' / '9999-99-99' 가 전부 통과하던 것을 막는다)
  # expiry 도 같은 이유로 awk 안에서 끝낸다. 값 정제는 하지 않는다 — 숫자만 남기면
  # 'never' 가 빈 문자열이 되어 형식 검사를 빠져나간다. 원문 그대로 형식부터 본다.
  today=$(date +%Y-%m-%d)
  bad_expiry=$(printf '%s\n' "$sup" | awk -v today="$today" '
    /^ *expiry:/ {
      v = $0; sub(/^ *expiry: */, "", v); gsub(/["\x27]/, "", v)
      gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
      if (v !~ /^[0-9][0-9][0-9][0-9]-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$/) { print "형식\t" v; next }
      if (v < today) print "만료\t" v
    }')
  if [ -n "$bad_expiry" ]; then
    while IFS=$'\t' read -r kind val; do
      [ -z "$kind" ] && continue
      if [ "$kind" = "형식" ]; then
        block "expiry 형식이 YYYY-MM-DD 가 아니다: '${val}' — 만료를 판정할 수 없는 억제는 무기한 억제다 (P13)"
      else
        block "만료된 억제가 남아 있다 (expiry: $val < 오늘 $today) — 유예는 기한이 지나면 해제되어야 한다 (P13)"
      fi
    done <<< "$bad_expiry"
  fi
fi

# ── 5) LLM 출력 숫자를 판정 필드에 (P14 · v4 QA-094 재현 방지) ────────────────
while IFS= read -r f; do
  case "$f" in
    *.js|*.mjs|*.ts|*.tsx|*.py)
      if scan "LLM판정-소스" "$f" -iE 'llm|gpt|claude|completion|chat\(' &&
         scan "LLM판정-필드" "$f" -iE 'score|rating|fit_|적합도' &&
         scan "LLM판정-변환" "$f" -E 'parseFloat|parseInt|Number\(|float\('; then
        block "LLM 출력을 판정 수치로 변환 — $f. 판정 수치는 순수 함수가 만든다 (P14)"
      fi
      ;;
  esac
done <<< "$staged"

# ── 6) 외부 효과 모듈에 네트워크 호출 0건 (P4 · §0 E5 gptreview.js 재현 방지) ──
NET='fetch\(|axios|https?\.|requests\.|urllib|playwright|puppeteer|page\.goto|XMLHttpRequest|WebSocket|subprocess|execSync'
while IFS= read -r f; do
  case "$f" in
    *login*|*portal*|*scrap*|*crawl*|*gptreview*|*fetch*|*api*)
      case "$f" in
        *.js|*.mjs|*.ts|*.tsx|*.py)
          if ! scan "외부효과-네트워크" "$f" -iE "$NET"; then
            block "외부 효과를 표방하는데 네트워크 호출이 0건 — $f. 시뮬레이션 의심 (P4)"
          fi
          ;;
      esac
      ;;
  esac
done <<< "$staged"

# ── 7) 대용량 파일 · 산출물 경로 (P21 · AC-A4) ────────────────────────────────
#
# 왜: v6 는 후보자 개인정보(이름·학력·경력·프로필URL)를 로컬 SQLite 와 artifacts/ 에
# 쌓는다. 구현 계획 §8 은 그 보호를 "gitignore + 1MB 차단"에 기대는데, 2026-08-08
# 실측에서 **둘 다 존재하지 않았다**. gitignore 만으로는 부족하다 — `git add -f` 가
# 무시 규칙을 건너뛰므로, 경로 차단을 훅에도 둔다(차단 지점 2곳).
#
# 크기는 작업트리가 아니라 **인덱스 blob** 에서 잰다. 작업트리를 재면
# `git add <큰 파일>` 후 작업트리만 작은 내용으로 덮어써서 우회할 수 있다
# (§1 비밀 스캔이 VERIFY_SCAN_SOURCE=index 를 쓰는 것과 같은 이유).
#
# 경로 패턴은 **하위 디렉터리까지** 덮는다. 최상위만 보면 src/artifacts/nav.png 로 뚫린다
# (2026-08-09 보안 재검증 실측). gitignore 는 원래 모든 깊이를 덮으므로, 훅만 좁았던 것이다.
# 확장자도 사이드카를 포함한다 — SQLite WAL(.db-wal / .sqlite3-wal)은 아직 본체에 반영되지
# 않은 행 전체를 담고, .jsonl/.ndjson/.parquet 은 후보자 덤프의 실제 형식이다.
# 의도적으로 뺀 것: *.sql(마이그레이션이 정상 산출물) · *.csv(소형 픽스처와 구분 불가).
# 그 둘은 크기 검사와 비밀/PII 내용 검사에 맡긴다 — 여기서 막으면 정상 작업이 멈춘다.
MAX_BYTES=1048576
while IFS= read -r f; do
  if [ -z "$f" ]; then continue; fi
  # 확장자 비교는 대소문자를 무시한다. dump.DB 가 그냥 통과했다(2026-08-09 실측).
  lf=$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')
  case "$lf" in
    artifacts/*|*/artifacts/*|data/*|*/data/*|private-reviews/*|*/private-reviews/*|\
    *.db|*.db-*|*.sqlite|*.sqlite-*|*.sqlite3|*.sqlite3-*|*.jsonl|*.ndjson|*.parquet)
      block "산출물·데이터 경로는 커밋하지 않는다 — $f (P21 · 후보자 PII)"
      continue
      ;;
  esac
  sz=$(git cat-file -s ":$f" 2>&1) || sz=""
  case "$sz" in
    ''|*[!0-9]*)
      block_unrunnable "스테이지된 blob 크기를 읽지 못했다 — $f (fail-closed)"
      ;;
    *)
      if [ "$sz" -gt "$MAX_BYTES" ]; then
        block "1MB 초과 파일 — $f (${sz} 바이트, P21). 데이터는 git 밖에 둔다"
      fi
      ;;
  esac
done <<< "$staged"

# ── 8) P3 조용한 실패 — 스테이지된 확정본만 검사한다 ────────────────────────
# 작업트리를 읽으면 `git add bad.js` 뒤 작업트리만 고쳐 커밋을 우회할 수 있다.
p3_files=()
while IFS= read -r -d '' f; do
  p3_path=$(printf '%s' "$f" | tr '[:upper:]' '[:lower:]')
  case "$p3_path" in
    *.py|*.js|*.jsx|*.mjs|*.cjs|*.ts|*.tsx|*.mts|*.cts) p3_files+=("$f") ;;
  esac
done < <(git diff --cached --name-only -z --diff-filter=ACMR)

if [ "${#p3_files[@]}" -gt 0 ]; then
  p3_tmp=$(mktemp -d) || p3_tmp=""
  if [ -z "$p3_tmp" ]; then
    block_unrunnable "P3 임시 검사 공간 생성 실패 (fail-closed)"
  elif ! git cat-file -e ":scripts/acceptance-silent-failure-lint.sh" 2>/dev/null; then
    block_unrunnable "P3 린터가 인덱스에 없다 — scripts/acceptance-silent-failure-lint.sh"
  else
    mkdir -p "$p3_tmp/tree"
    git show ":scripts/acceptance-silent-failure-lint.sh" > "$p3_tmp/lint.sh"
    p3_stage_error=0
    for f in "${p3_files[@]}"; do
      mkdir -p "$p3_tmp/tree/$(dirname "$f")"
      if ! git show ":$f" > "$p3_tmp/tree/$f"; then
        block_unrunnable "P3가 스테이지된 파일을 읽지 못했다 — $f"
        p3_stage_error=1
      fi
    done
    if [ "$p3_stage_error" -eq 0 ]; then
      p3_rc=0
      p3_repo=$PWD
      if cd "$p3_tmp/tree"; then
        bash ${p3_tmp}/lint.sh "${p3_files[@]}" > "$p3_tmp/output" 2>&1 || p3_rc=$?
        cd "$p3_repo" || block_unrunnable "P3 검사 뒤 저장소 루트로 복귀하지 못했다"
      else
        p3_rc=2
      fi
      if [ "$p3_rc" -eq 1 ]; then
        first_hit=$(grep '^FAIL:' "$p3_tmp/output" | head -1 | sed 's/ — .*//')
        block "조용한 실패 패턴 발견 (P3) — ${first_hit:-상세 없음}"
      elif [ "$p3_rc" -ne 0 ]; then
        block_unrunnable "P3 린터가 판정을 완료하지 못했다 (exit=$p3_rc, fail-closed)"
      fi
    fi
  fi
  if [ -n "${p3_tmp:-}" ]; then
    ruby -rfileutils -e 'FileUtils.remove_entry(ARGV[0]) if File.exist?(ARGV[0])' "$p3_tmp"
  fi
fi

write_summary
exit "$fail"
