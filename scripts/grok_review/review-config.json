{
  "max_changed_lines_per_chunk": 800,
  "max_chunks": 3,
  "call_timeout_seconds": 480,
  "max_findings_per_chunk": 7,
  "reason_max_chars": 300,
  "exclude_globs": [
    "**/*.lock",
    "**/package-lock.json",
    "**/pnpm-lock.yaml",
    "**/yarn.lock",
    "**/dist/**",
    "**/*.min.js",
    "**/__snapshots__/**",
    "**/*.snap",
    "**/*.png",
    "**/*.jpg",
    "**/*.jpeg",
    "**/*.gif",
    "**/*.webp",
    "**/*.ico",
    "**/*.pdf",
    "**/*.zip",
    "**/*.gz",
    "**/*.woff",
    "**/*.woff2",
    "**/*.pyc",
    "**/*.db",
    "**/*.sqlite",
    "**/*.sqlite3",
    "**/*.wasm",
    "**/*.mp4",
    "**/*.mov"
  ]
}
